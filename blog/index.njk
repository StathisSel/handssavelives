---
title: "Ενημέρωση"
pagination:
  data: collections.blog
  size: 20
permalink: "/blog/index.html"
---

<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title }} | Handssavelives</title>
</head>
<body>
  <main style="max-width: 860px; margin: 40px auto; padding: 0 16px;">
    <h1>{{ title }}</h1>

    <ul>
      {% for post in pagination.items | reverse %}
        <li style="margin: 10px 0;">
          <a href="{{ post.url }}">{{ post.data.title }}</a>
          <small> — {{ post.date | date("dd/MM/yyyy") }}</small>
        </li>
      {% endfor %}
    </ul>
  </main>
</body>
</html>
